# Copy this file to .env and fill in your values

# Port the Express server listens on (defaults to 3000)
PORT=3000

# Set to "production" to hide error stack traces in API responses
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/nigeria-tertiary-institutions

# Admin dashboard login (/admin). Change both before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# The secrets below are placeholders for local use only. In production, replace each with its own value from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signs admin session cookies; changing it logs everyone out
ADMIN_SESSION_SECRET=dev-session-secret-change-me

# Hashes consumer IPs; changing it resets unique-consumer counts
IP_HASH_SALT=dev-ip-hash-salt-change-me

# Secret Vercel Cron sends to /admin/cron/rollup (set the same value in the Vercel project)
CRON_SECRET=dev-cron-secret-change-me
